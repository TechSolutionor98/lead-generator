# ---------------------------------------------------------------------------
# GrabLeads FRONTEND configuration (Vite) — copy to client/.env and adjust.
# Backend config is separate: see the root .env / .env.example.
#
# Only variables prefixed NEXT_PUBLIC_ (or VITE_) are exposed to the browser.
# ---------------------------------------------------------------------------

# Full URL of the backend API the client calls.
#   Local dev:   http://localhost:5050
#   Production:  https://api.yourdomain.com
#
# Leave empty to use the Vite dev proxy instead (same-origin /api → :5050).
NEXT_PUBLIC_API_URL=http://localhost:5050
