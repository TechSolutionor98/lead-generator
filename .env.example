# ---------------------------------------------------------------------------
# GrabLeads configuration — copy this file to .env and adjust as needed.
# Everything here works at ZERO cost. No paid API keys are required.
# ---------------------------------------------------------------------------

# HTTP port for the backend API (the Vite client proxies /api to this).
PORT=5050

# --- MongoDB (required) -----------------------------------------------------
# GrabLeads stores jobs + leads in MongoDB. Use a MongoDB Atlas connection
# string (the free M0 tier is enough). Create a free cluster + database user
# at https://www.mongodb.com/atlas, then paste the "Connect your application"
# URI here (put your real password in place of <password>):
#   MONGODB_URI=mongodb+srv://USER:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Leave blank and the app still loads, but collecting/exporting fails with a
# clear "configure MONGODB_URI" message until it is set.
MONGODB_URI=
# Database name to use inside the cluster (created automatically on first write).
MONGODB_DB=grableads

# --- 2GIS (free, but needs a key) -------------------------------------------
# 2GIS requires a key. A FREE "demo" key from the 2GIS Platform Manager works
# (no payment; ~2 min signup — see README). Paste it here. Leave blank to skip
# the 2GIS source entirely (OSM + Yandex + Avito still run with no key at all).
#
# Alternatively, paste the public web key from the 2gis.ru network tab and set
# TWOGIS_API_HOST=catalog.api.2gis.ru below.
TWOGIS_WEB_KEY=
TWOGIS_API_HOST=catalog.api.2gis.com

# --- OpenStreetMap / Overpass (free, no key) --------------------------------
# Public Overpass mirror. Alternatives if busy:
#   https://overpass.kumi.systems/api/interpreter
#   https://overpass.openstreetmap.ru/api/interpreter
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Yandex Maps (free: Playwright browser scraper) -------------------------
# Run the scraping browser headless (true) or visible (false). Set to false
# when you want to watch it, or to solve a SmartCaptcha by hand so it can
# continue. Requires: npx playwright install chromium
YANDEX_HEADLESS=true

# --- Networking -------------------------------------------------------------
# Optional single HTTP(S) proxy applied to ALL outbound requests
# (adapters + email enricher + Playwright). Example:
#   PROXY_URL=http://user:pass@host:port
PROXY_URL=

# Global politeness: max outbound requests per second, per source.
REQ_PER_SEC=5

# --- Email enrichment -------------------------------------------------------
# Default for the "enrich email" toggle. When on, leads that have a website
# but no email are enriched by fetching the business's OWN site only.
ENRICH_EMAIL=false
